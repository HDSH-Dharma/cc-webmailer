APP_NAME="Nada Senja Live"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Herd: http://cc-webmailer.test  |  CloudPanel: https://hdsh.mav.my.id
APP_URL=http://cc-webmailer.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Purelymail SMTP (https://purelymail.com/docs/setup/technical)
# Use the full mailbox address as the username and that mailbox's password.
# Never commit the real password -- it only goes in .env.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.purelymail.com
MAIL_PORT=465
MAIL_USERNAME=hdsh@mav.my.id
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hdsh@mav.my.id"
MAIL_FROM_NAME="Nada Senja Live 2026"

# Concert / registration settings (config/concert.php)
CONCERT_NAME="Nada Senja Live 2026"
CONCERT_DATE="Saturday, December 12, 2026 · 19:00 WIB"
CONCERT_VENUE="Surabaya, Indonesia"
CONCERT_CONFIRM_DAYS=7
CONCERT_CONTACT_EMAIL="hdsh@mav.my.id"
# Optional hidden copy of every confirmation email (leave empty to disable)
CONCERT_BCC_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
